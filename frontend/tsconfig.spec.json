/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    /* electron/ 的純函式（helper 輸出解析 / 視窗標題 / log 欄位白名單）由
       src/app/core/print/electron-print-form.spec.ts 測試；unit-test builder 只掃 src/，
       所以 spec 放 src、被測檔在這裡補進型別檢查範圍。 */
    "electron/print-form-core.ts"
  ]
}
