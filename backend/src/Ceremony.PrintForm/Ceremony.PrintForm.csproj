<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows（不是 net10.0）：System.Drawing.Common 的 API 全標 [SupportedOSPlatform("windows")]，
         平台中立的 TFM 下呼叫會噴 CA1416。刻意做成獨立 exe 而不是塞進 Ceremony.Api，就是為了不讓這個
         TFM 傳染到 Api → IntegrationTests（那會讓 macOS 開發機再也跑不了整合測試）。
         另兩個理由：DocumentProperties 是驅動程式碼，網路印表機離線時會整條執行緒卡住且不吃
         CancellationToken，獨立子行程才砍得掉；以及「改這台電腦的印表機預設值」是桌面端的機器狀態
         變更，不該躲在 HTTP endpoint 後面。見 docs/blueprints/print-channel-electron.md 決策 9。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ceremony.PrintForm</RootNamespace>
    <AssemblyName>Ceremony.PrintForm</AssemblyName>
    <!-- 與 Ceremony.Migrations 同理：Exe＋RID 預設 SelfContained=true 會觸發 NETSDK1151。見 docs/gotchas.md。 -->
    <SelfContained>false</SelfContained>
    <!-- macOS/Linux 上 restore/build windows TFM 需要（CI 與開發機都會 build 到）。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 刻意不開 UseWindowsForms：只要 System.Drawing.Common 的 PrinterSettings.PaperSizes，
         開了會拉進整個 WindowsDesktop 目標套件，體積暴增。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- 表單名 + 尺寸 + 比對邏輯的唯一權威（平台中立，macOS 測得到）。 -->
    <ProjectReference Include="..\Ceremony.Domain\Ceremony.Domain.csproj" />
  </ItemGroup>

</Project>
